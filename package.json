{
  "name": "flight-academy-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:real": "next dev",
    "dev:emulators": "firebase emulators:exec --only auth,firestore \"next dev\"",
    "start": "next start",
    "build": "next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore",
    "dev:firebase": "next dev",
    "seed:firebase": "tsx scripts/seedFirestore.ts",
    "seed:emulator": "firebase emulators:exec --only firestore \"tsx scripts/seedFirestore.ts\"",
    "admin:set": "tsx scripts/setAdminClaim.ts",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "test": "vitest run tests/admin-validation.test.ts tests/content-fidelity.test.ts tests/local-migration.test.ts tests/pwa.test.ts tests/no-storage-mode.test.ts tests/progress-profile-state.test.ts tests/checklists-aircraft-organization.test.ts",
    "test:pwa": "vitest run tests/pwa.test.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firebase-rules.test.ts\"",
    "test:firebase": "firebase emulators:exec --only auth,firestore \"vitest run tests/firebase-auth-emulator.test.ts tests/firebase-rules.test.ts\"",
    "test:storage:rules": "firebase emulators:exec --only storage \"vitest run tests/firebase-storage-rules.test.ts\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "^12.16.0",
    "lucide-react": "0.468.0",
    "next": "15.5.21",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.21",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "postcss": "8.5.12",
    "tailwindcss": "3.4.7",
    "tsx": "^4.23.1",
    "typescript": "5.5.4",
    "vitest": "^4.1.10"
  }
}
